.message-row { display: flex; margin: 20rpx 0; }
.user-row { justify-content: flex-end; }
.assistant-row { justify-content: flex-start; }
.bubble { max-width: 82%; padding: 22rpx 26rpx; border-radius: 22rpx; line-height: 1.6; word-break: break-word; }
.user-bubble { color: #fff; background: #4f6ef7; border-bottom-right-radius: 6rpx; }
.assistant-bubble { color: #303646; background: #fff; border-bottom-left-radius: 6rpx; }
