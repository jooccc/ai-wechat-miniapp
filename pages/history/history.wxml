<view class="page history-page">
  <view wx:if="{{conversations.length}}" class="history-list">
    <view wx:for="{{conversations}}" wx:key="id" class="card history-card" data-id="{{item.id}}" bindtap="openConversation">
      <view class="history-top"><text class="history-title">{{item.title}}</text><text class="history-time">{{item.displayTime}}</text></view>
      <view class="history-preview">{{item.preview}}</view>
      <view class="history-actions"><text class="delete" catchtap="deleteConversation" data-id="{{item.id}}">删除</text></view>
    </view>
  </view>
  <view wx:else class="empty card">
    <view class="empty-icon">◷</view>
    <view class="empty-title">暂无历史记录</view>
    <view class="muted">开始对话后，记录会显示在这里</view>
  </view>
</view>
