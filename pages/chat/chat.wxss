.chat-page { display: flex; flex-direction: column; height: 100vh; }
.messages { flex: 1; min-height: 0; padding: 26rpx 30rpx; box-sizing: border-box; }
.welcome { margin-top: 25vh; text-align: center; color: #89909f; font-size: 24rpx; }
.welcome-icon { color: #637df8; font-size: 58rpx; }
.welcome-title { margin: 18rpx 0 10rpx; color: #333b4d; font-size: 32rpx; font-weight: 600; }
.loading { padding: 12rpx 4rpx; color: #89909f; font-size: 23rpx; }
.error { margin: 12rpx 0; padding: 18rpx 22rpx; border-radius: 14rpx; color: #a84c42; background: #fff0ed; font-size: 23rpx; }
.composer-wrap { padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #eceef3; }
.composer { display: flex; align-items: center; padding: 10rpx 10rpx 10rpx 24rpx; border-radius: 20rpx; background: #f4f5f8; }
.chat-input { flex: 1; height: 72rpx; font-size: 28rpx; }
.send-button { margin: 0; padding: 0 26rpx; height: 66rpx; line-height: 66rpx; color: #fff; background: #4f6ef7; border-radius: 16rpx; font-size: 25rpx; }
.send-button[disabled] { opacity: .45; }
.footnote { padding-top: 12rpx; text-align: center; color: #a3aab6; font-size: 20rpx; }
