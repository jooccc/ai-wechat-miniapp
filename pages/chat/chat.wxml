<view class="chat-page">
  <scroll-view class="messages" scroll-y scroll-into-view="{{lastMessageId}}">
    <view wx:if="{{!messages.length}}" class="welcome">
      <view class="welcome-icon">✦</view>
      <view class="welcome-title">开始一段新对话</view>
      <view class="muted">输入你的问题，AI 助手会在这里回复</view>
    </view>
    <block wx:for="{{messages}}" wx:key="createdAt">
      <message-item message="{{item}}" />
    </block>
    <view wx:if="{{sending}}" class="loading">正在发送…</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </scroll-view>
  <view class="composer-wrap">
    <view class="composer">
      <input class="chat-input" value="{{inputValue}}" placeholder="输入消息…" confirm-type="send" bindinput="onInput" bindconfirm="sendMessage" />
      <button class="send-button" disabled="{{sending || !inputValue}}" bindtap="sendMessage">发送</button>
    </view>
    <view class="footnote">AI 回复由已配置的服务提供</view>
  </view>
</view>
